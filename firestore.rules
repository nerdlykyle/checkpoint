rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{boardId} {
      function signedIn() {
        return request.auth != null;
      }

      function validBoardId() {
        return boardId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$');
      }

      function isMember() {
        return signedIn() && resource.data.members[request.auth.uid] != null;
      }

      function validBoard() {
        return request.resource.data.games is list
          && request.resource.data.games.size() <= 2000
          && request.resource.data.members is map;
      }

      function validSelfProfile() {
        let profile = request.resource.data.members[request.auth.uid];
        return profile.keys().hasOnly([
            'name', 'persona', 'email', 'photoUrl', 'googlePhotoUrl', 'customPhotoUrl',
            'joinedAt', 'steamId', 'steamName', 'steamProfileUrl', 'steamAvatarUrl'
          ])
          && profile.email == request.auth.token.email
          && profile.email is string
          && profile.email.size() <= 320
          && profile.name is string
          && profile.name.size() <= 40
          && profile.photoUrl is string
          && profile.photoUrl.size() <= 180000
          && profile.joinedAt is string
          && profile.joinedAt.size() <= 40
          && (!profile.keys().hasAny(['googlePhotoUrl']) || (profile.googlePhotoUrl is string && profile.googlePhotoUrl.size() <= 2000))
          && (!profile.keys().hasAny(['customPhotoUrl']) || (profile.customPhotoUrl is string && profile.customPhotoUrl.size() <= 180000))
          && (!profile.keys().hasAny(['steamId']) || (profile.steamId is string && profile.steamId.matches('^7656[0-9]{13}$')))
          && (!profile.keys().hasAny(['steamName']) || (profile.steamName is string && profile.steamName.size() <= 100))
          && (!profile.keys().hasAny(['steamProfileUrl']) || (profile.steamProfileUrl is string && profile.steamProfileUrl.size() <= 500))
          && (!profile.keys().hasAny(['steamAvatarUrl']) || (profile.steamAvatarUrl is string && profile.steamAvatarUrl.size() <= 500))
          && (profile.persona == 'Jern'
            || profile.persona == 'Vern'
            || (profile.persona == 'Nern' && request.auth.token.email == 'kjsparsons@gmail.com'));
      }

      function joiningOnlyAsSelf() {
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && validSelfProfile();
      }

      allow get: if validBoardId() && signedIn();
      allow list, delete: if false;
      allow create: if validBoardId()
        && signedIn()
        && validBoard()
        && request.resource.data.ownerUid == request.auth.uid
        && validSelfProfile();
      allow update: if validBoardId()
        && ((isMember() && validBoard()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['games', 'updatedAt']))
          || joiningOnlyAsSelf());

      match /puzzles/{gameId} {
        function isBoardMember() {
          return request.auth != null
            && get(/databases/$(database)/documents/boards/$(boardId)).data.members[request.auth.uid] != null;
        }

        function validPuzzle() {
          return request.resource.data.keys().hasOnly([
              'imageDataUrl', 'imageName', 'note', 'strokes', 'updatedBy', 'updatedAt'
            ])
            && request.resource.data.imageDataUrl is string
            && request.resource.data.imageDataUrl.size() <= 650000
            && request.resource.data.imageName is string
            && request.resource.data.imageName.size() <= 200
            && request.resource.data.note is string
            && request.resource.data.note.size() <= 20000
            && request.resource.data.strokes is list
            && request.resource.data.strokes.size() <= 500
            && request.resource.data.updatedBy == request.auth.uid;
        }

        allow get: if isBoardMember();
        allow list: if false;
        allow create, update: if isBoardMember() && validPuzzle();
        allow delete: if isBoardMember();
      }
    }
  }
}
