rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function boardMember(boardId) {
      let board = get(/databases/$(database)/documents/boards/$(boardId)).data;
      return request.auth != null && board.members.get(request.auth.uid, null) != null
        && !board.get('removedMembers', {}).get(request.auth.uid, false);
    }
    function verifiedGoogle() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function boardOwner(boardId) {
      return boardMember(boardId)
        && get(/databases/$(database)/documents/boards/$(boardId)).data.ownerUid == request.auth.uid;
    }
    // Private notes never live in the shared board document.
    match /readerNotes/{userId}/{kind}/{itemId} {
      allow read, delete: if kind in ['books', 'music'] && request.auth != null && request.auth.uid == userId;
      allow create, update: if kind in ['books', 'music'] && request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['note', 'updatedAt'])
        && request.resource.data.note is string && request.resource.data.note.size() <= 4000
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
    }
    match /musicPreferences/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['service']) && request.resource.data['service'] in ['spotify', 'youtube'];
    }
    match /boards/{boardId} {
      function signedIn() {
        return request.auth != null;
      }

      function validBoardId() {
        return boardId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$');
      }

      function isMember() {
        return signedIn() && resource.data.members.get(request.auth.uid, null) != null
          && !resource.data.get('removedMembers', {}).get(request.auth.uid, false);
      }

      function validBoard() {
        return request.resource.data.games is list
          && request.resource.data.games.size() <= 2000
          && (!request.resource.data.keys().hasAny(['books'])
            || (request.resource.data.books is list && request.resource.data.books.size() <= 1000))
          && (!request.resource.data.keys().hasAny(['gameNights'])
            || (request.resource.data.gameNights is list && request.resource.data.gameNights.size() <= 200))
          && (!request.resource.data.keys().hasAny(['sessions'])
            || (request.resource.data.sessions is list && request.resource.data.sessions.size() <= 500))
          && (!request.resource.data.keys().hasAny(['activity'])
            || (request.resource.data.activity is list && request.resource.data.activity.size() <= 250))
          && (!request.resource.data.keys().hasAny(['recommendationFeedback'])
            || (request.resource.data.recommendationFeedback is map && request.resource.data.recommendationFeedback.size() <= 500))
          && request.resource.data.members is map;
      }

      function validSelfProfile() {
        let profile = request.resource.data.members[request.auth.uid];
        return profile.keys().hasOnly([
            'name', 'persona', 'email', 'photoUrl', 'googlePhotoUrl', 'customPhotoUrl',
            'joinedAt', 'steamId', 'steamName', 'steamProfileUrl', 'steamAvatarUrl',
            'steamLinkPreference', 'preferredMode', 'bookmarkColor'
          ])
          && profile.email == request.auth.token.email
          && profile.email is string
          && profile.email.size() <= 320
          && profile.name is string
          && profile.name.size() <= 40
          && profile.photoUrl is string
          && profile.photoUrl.size() <= 180000
          && profile.joinedAt is string
          && profile.joinedAt.size() <= 40
          && (!profile.keys().hasAny(['googlePhotoUrl']) || (profile.googlePhotoUrl is string && profile.googlePhotoUrl.size() <= 2000))
          && (!profile.keys().hasAny(['customPhotoUrl']) || (profile.customPhotoUrl is string && profile.customPhotoUrl.size() <= 180000))
          && (!profile.keys().hasAny(['steamId']) || (profile.steamId is string && profile.steamId.matches('^7656[0-9]{13}$')))
          && (!profile.keys().hasAny(['steamName']) || (profile.steamName is string && profile.steamName.size() <= 100))
          && (!profile.keys().hasAny(['steamProfileUrl']) || (profile.steamProfileUrl is string && profile.steamProfileUrl.size() <= 500))
          && (!profile.keys().hasAny(['steamAvatarUrl']) || (profile.steamAvatarUrl is string && profile.steamAvatarUrl.size() <= 500))
          && (!profile.keys().hasAny(['steamLinkPreference']) || profile.steamLinkPreference in ['auto', 'app', 'browser'])
          && (!profile.keys().hasAny(['preferredMode']) || profile.preferredMode in ['games', 'books', 'music'])
          && (!profile.keys().hasAny(['bookmarkColor']) || (profile.bookmarkColor is string && profile.bookmarkColor.matches('^#[0-9a-fA-F]{6}$')))
          && (!profile.keys().hasAny(['persona']) || profile.persona in ['Nern', 'Jern', 'Vern'])
          && profile.joinedAt == resource.data.members[request.auth.uid].joinedAt;
      }

      function editingOwnProfile() {
        return isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && validSelfProfile();
      }

      function acceptingManualInvite() {
        let uid = request.auth.uid;
        let next = request.resource.data;
        let id = next.membershipClaims[uid];
        let invitePath = /databases/$(database)/documents/boards/$(boardId)/manualInvites/$(id);
        let invite = get(invitePath).data;
        let consumed = getAfter(invitePath).data;
        let profile = next.members[uid];
        return verifiedGoogle() && id.matches('^[a-f0-9]{64}$')
          && resource.data.members.get(uid, null) == null
          && !resource.data.get('removedMembers', {}).get(uid, false)
          && next.diff(resource.data).affectedKeys().hasOnly(['members', 'membershipClaims', 'updatedAt'])
          && next.members.diff(resource.data.members).affectedKeys().hasOnly([uid])
          && next.membershipClaims.diff(resource.data.get('membershipClaims', {})).affectedKeys().hasOnly([uid])
          && next.updatedAt == request.time
          && profile.keys().hasOnly(['name', 'email', 'photoUrl', 'joinedAt'])
          && profile.name is string && profile.name.size() > 0 && profile.name.size() <= 40
          && profile.email == request.auth.token.email && profile.photoUrl == ''
          && profile.joinedAt is string && profile.joinedAt.size() > 0 && profile.joinedAt.size() <= 40
          && invite.status == 'pending' && invite.expiresAt > request.time
          && invite.email == request.auth.token.email.lower()
          && consumed.status == 'used' && consumed.usedBy == uid && consumed.usedAt == request.time;
      }

      allow get: if validBoardId() && isMember();
      allow list, delete: if false;
      // No self-created groups; new membership requires an atomic invite claim.
      allow create: if false;
      allow update: if validBoardId()
        && ((isMember() && validBoard()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['games', 'books', 'gameNights', 'sessions', 'activity', 'recommendationFeedback', 'updatedAt']))
          || editingOwnProfile() || (signedIn() && acceptingManualInvite()));

      match /manualInvites/{inviteId} {
        function recipient() {
          return verifiedGoogle() && resource.data.email == request.auth.token.email.lower();
        }
        function consuming() {
          let boardPath = /databases/$(database)/documents/boards/$(boardId);
          let before = get(boardPath).data;
          let after = getAfter(boardPath).data;
          return recipient() && resource.data.status == 'pending' && resource.data.expiresAt > request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy', 'usedAt'])
            && request.resource.data.status == 'used' && request.resource.data.usedBy == request.auth.uid
            && request.resource.data.usedAt == request.time
            && before.members.get(request.auth.uid, null) == null
            && after.members[request.auth.uid].email == request.auth.token.email
            && after.membershipClaims[request.auth.uid] == inviteId;
        }
        allow get: if boardOwner(boardId) || recipient();
        allow list: if boardOwner(boardId);
        allow create: if boardOwner(boardId) && verifiedGoogle() && inviteId.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['email', 'createdBy', 'createdAt', 'expiresAt', 'status'])
          && request.resource.data.email is string && request.resource.data.email.size() <= 320
          && request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
          && request.resource.data.email == request.resource.data.email.lower()
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
          && request.resource.data.status == 'pending';
        allow update: if consuming() || (boardOwner(boardId) && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt'])
          && request.resource.data.status == 'revoked' && request.resource.data.revokedAt == request.time);
        allow delete: if false;
      }

      match /music/{musicId} {
        function musicMember() { return boardMember(boardId); }
        allow read: if musicMember();
        allow create, update: if musicMember()
          && request.resource.data.id == musicId
          && request.resource.data.kind in ['album','ep','song']
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 250
          && request.resource.data.artists is list && request.resource.data.artists.size() > 0 && request.resource.data.artists.size() <= 20
          && request.resource.data.description is string && request.resource.data.description.size() <= 5000
          && request.resource.data.genres is list && request.resource.data.genres.size() <= 20
          && request.resource.data.tracks is list && request.resource.data.tracks.size() <= 150
          && request.resource.data.links is map && request.resource.data.shelves is map
          && request.resource.data.organization is map && request.resource.data.ratings is map
          && request.resource.data.favoriteTracks is map && request.resource.data.favorites is list
          && request.resource.data.comments is list && request.resource.data.comments.size() <= 300
          && request.resource.data.listens is list && request.resource.data.listens.size() <= 500
          && request.resource.data.upvotes is list && request.resource.data.downvotes is list;
        allow delete: if false;
      }
      match /artistFavorites/{readerId}/artists/{artistId} {
        function artistMember() { return boardMember(boardId); }
        function artistUrl(value) { return value is string && value.size() <= 2048 && (value == '' || value.matches('https://.*')); }
        allow read: if artistMember();
        allow create, update: if artistMember() && request.auth.uid == readerId
          && request.resource.data.keys().hasOnly(['id','name','description','imageUrl','imageSource','imageCredit','imageLicense','imageLicenseUrl','spotify','youtube','active','createdAt','updatedAt'])
          && request.resource.data.id == artistId && artistId.matches('[a-zA-Z0-9-]{1,100}')
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 250
          && request.resource.data.description is string && request.resource.data.description.size() <= 500
          && request.resource.data.imageCredit is string && request.resource.data.imageCredit.size() <= 600
          && request.resource.data.imageLicense is string && request.resource.data.imageLicense.size() <= 200
          && artistUrl(request.resource.data.imageUrl) && artistUrl(request.resource.data.imageSource)
          && artistUrl(request.resource.data.imageLicenseUrl) && artistUrl(request.resource.data.spotify) && artistUrl(request.resource.data.youtube)
          && request.resource.data.active is bool && request.resource.data.createdAt is string && request.resource.data.updatedAt is string;
        allow delete: if false;
      }
      match /musicState/{stateId} {
        function musicMember() { return boardMember(boardId); }
        allow read: if musicMember();
        allow create, update: if stateId == 'current' && musicMember() && request.resource.data.keys().hasOnly(['musicId']) && request.resource.data.musicId is string;
      }

      match /puzzles/{gameId} {
        function isBoardMember() {
          return boardMember(boardId);
        }

        function validLegacyPuzzle() {
          return request.resource.data.keys().hasAll([
              'imageDataUrl', 'imageName', 'note', 'strokes', 'updatedBy', 'updatedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'imageDataUrl', 'imageName', 'note', 'strokes', 'updatedBy', 'updatedAt'
            ])
            && request.resource.data.imageDataUrl is string
            && request.resource.data.imageDataUrl.size() <= 650000
            && request.resource.data.imageName is string
            && request.resource.data.imageName.size() <= 200
            && request.resource.data.note is string
            && request.resource.data.note.size() <= 20000
            && request.resource.data.strokes is list
            && request.resource.data.strokes.size() <= 500
            && request.resource.data.updatedBy == request.auth.uid;
        }

        function validPuzzleManifest() {
          return request.resource.data.keys().hasAll([
              'version', 'pages', 'updatedBy', 'updatedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'version', 'pages', 'updatedBy', 'updatedAt'
            ])
            && request.resource.data.version == 2
            && request.resource.data.pages is list
            && request.resource.data.pages.size() > 0
            && request.resource.data.pages.size() <= 20
            && request.resource.data.updatedBy == request.auth.uid;
        }

        allow get: if isBoardMember();
        allow list: if false;
        allow create, update: if isBoardMember()
          && (validPuzzleManifest() || validLegacyPuzzle());
        allow delete: if isBoardMember();

        match /pages/{pageId} {
          function isBoardMemberForPage() {
            return boardMember(boardId);
          }

          function validPuzzlePage() {
            return request.resource.data.keys().hasAll([
                'title', 'note', 'strokes', 'images', 'updatedBy', 'updatedAt'
              ])
              && request.resource.data.keys().hasOnly([
                'title', 'note', 'strokes', 'images', 'updatedBy', 'updatedAt'
              ])
              && request.resource.data.title is string
              && request.resource.data.title.size() > 0
              && request.resource.data.title.size() <= 80
              && request.resource.data.note is string
              && request.resource.data.note.size() <= 20000
              && request.resource.data.strokes is list
              && request.resource.data.strokes.size() <= 500
              && request.resource.data.images is list
              && request.resource.data.images.size() <= 6
              && request.resource.data.updatedBy == request.auth.uid;
          }

          allow get: if isBoardMemberForPage();
          allow list: if false;
          allow create, update: if isBoardMemberForPage() && validPuzzlePage();
          allow delete: if isBoardMemberForPage();
        }
      }
    }
  }
}
